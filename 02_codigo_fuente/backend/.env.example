# ─────────────────────────────────────────────────────────
# Copia este archivo como .env y llena los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────────────

# ─── Aplicación ─────────────────────────────────────────
APP_NAME=SolarQuote API
ENVIRONMENT=development
DEBUG=True

# ─── Base de datos (Neon) ───────────────────────────────
# La obtienes en el dashboard de Neon → Connection string
DATABASE_URL=postgresql://usuario:password@host.neon.tech/solarquote?sslmode=require

# ─── Seguridad ──────────────────────────────────────────
# Genera una clave con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar-por-una-clave-aleatoria-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CORS ───────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# ─── Microservicios ─────────────────────────────────────
IA_SERVICE_URL=http://localhost:8001
CALC_SERVICE_URL=http://localhost:8002
