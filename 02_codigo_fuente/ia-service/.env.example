APP_NAME=SolarQuote IA Service
ENVIRONMENT=development
DEBUG=True

# Mismo valor que IA_SERVICE_SECRET en el .env del backend.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_SERVICE_SECRET=cambiar-por-un-secreto-aleatorio-largo

# Clave de la API de Anthropic (console.anthropic.com > API Keys).
# Sin clave, los DXF se procesan igual; los PDF e imágenes responden 503.
# NUNCA subir la clave real al repositorio.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
